{
  "version": "2026-05-25",
  "packs": [
    {
      "id": "research-report",
      "name": "Research & Report",
      "required": true,
      "artifacts": ["report.md", "report.json"],
      "workflow": ["intake", "research", "synthesis", "export"],
      "entryCommand": "node tools/capability-packs/run-pack.mjs --pack=research-report"
    },
    {
      "id": "marketing-planning",
      "name": "Marketing Planning",
      "required": true,
      "artifacts": ["campaign-plan.md", "copy-pack.md"],
      "workflow": ["goal-setup", "audience-plan", "copy-draft", "approval"],
      "entryCommand": "node tools/capability-packs/run-pack.mjs --pack=marketing-planning"
    },
    {
      "id": "proposal-doc-output",
      "name": "Proposal & Document Outputs",
      "required": true,
      "artifacts": ["proposal.md", "proposal.pptx"],
      "workflow": ["brief", "outline", "draft", "review", "export"],
      "entryCommand": "node tools/capability-packs/run-pack.mjs --pack=proposal-doc-output"
    },
    {
      "id": "program-development",
      "name": "Program Development (Web/App)",
      "required": true,
      "artifacts": ["source-code", "test-report.json"],
      "workflow": ["spec", "implement", "test", "review"],
      "entryCommand": "node tools/capability-packs/run-pack.mjs --pack=program-development"
    },
    {
