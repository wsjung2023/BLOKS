{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",

  "permissions": {
    "allow": [
      "Bash(pnpm dev)",
      "Bash(pnpm build)",
      "Bash(pnpm lint)",
      "Bash(pnpm test)",
      "Bash(pnpm test:*)",
      "Bash(pnpm --filter * *)",
      "Bash(pnpm install)",
      "Bash(pnpm install *)",
      "Bash(pnpm add *)",
      "Bash(pnpm db:generate)",
      "Bash(pnpm db:migrate)",
      "Bash(pnpm db:studio)",
      "Bash(pnpm db:seed)",
      "Bash(pnpm verify:ci)",
      "Bash(pnpm smoke:*)",
      "Bash(pnpm progress:*)",
      "Bash(docker compose up*)",
      "Bash(docker compose ps)",
      "Bash(docker compose logs*)",
      "Bash(git status)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git add *)",
      "Bash(git commit*)",
      "Bash(git checkout *)",
      "Bash(git branch*)",
      "Bash(git fetch*)",
      "Bash(git pull*)",
      "Bash(git stash*)",
      "Bash(npx prisma *)",
      "Bash(node *)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(echo *)"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f *)",
      "Bash(pnpm db:push)",
      "Bash(rm -rf *)",
      "Bash(python scripts/generate-missing-sprites*)",
      "Bash(python scripts/remove-floor-characters*)"
    ]
  },

  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/typecheck-on-edit.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/pre-bash-guard.sh"
          }
        ]
      }
    ]
  },

  "env": {
    "NODE_ENV": "development"
  }
}
