# BLOKS monorepo .gitignore

# Dependencies
node_modules/
.pnpm-store/

# Build outputs
dist/
.next/
.turbo/
coverage/

# Environment — never commit real secrets
.env
.env.*
!.env.example

# Database
*.db
*.sqlite
prisma/dev.db
prisma/migrations/

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/
*.swp
*.swo

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Local DB data (migrated from Supabase)
.bloks-data/

# Playwright browser automation screenshots
.playwright-mcp/

# Screenshots / demo images (not source code)
*.png
*.pptx
*.zip
# Game assets (PNG) — these must be committed
!apps/web/public/**/*.png
char-b64.txt
chars-b64-batch*.txt
zoom-chars.txt

# Compiled JS output from shared packages (generated, not source)
packages/shared/src/**/*.js
packages/shared/src/**/*.d.ts
packages/shared/src/**/*.map

# Claude Code internal
.claude/scheduled_tasks.lock
.claude/settings.local.json

# tsbuildinfo
*.tsbuildinfo
