# BLOKS environment variable template (copy to .env)

# App
NODE_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
WORKER_CONCURRENCY=4

# Database (local)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/bloks

# Supabase (primary backend)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Optional fallback for local/dev when service-role key is unavailable.
SUPABASE_ANON_KEY=
SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Redis
REDIS_URL=redis://localhost:6379

# OpenAI (single provider for MVP)
OPENAI_API_KEY=
OPENAI_PROJECT_ID=
OPENAI_ORG_ID=

# Authentication (MVP single Founder account)
FOUNDER_EMAIL=
FOUNDER_PASSWORD=
SESSION_SECRET=

# AI Cost & Rate Controls
AI_MAX_RETRIES=2
AI_TASK_TIMEOUT_MS=120000
AI_MAX_COST_PER_TASK_USD=0.50
AI_DAILY_BUDGET_USD=20.00

# World Simulation Tick
WORLD_TICK_INTERVAL_MS=60000
WORLD_SNAPSHOT_INTERVAL_MS=3000

# Logging
LOG_LEVEL=debug
ENABLE_EVENT_LOG=true
ENABLE_AUDIT_LOG=true
