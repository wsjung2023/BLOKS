# BLOKS environment variable template — copy to .env and fill in values before running

# ─── App ────────────────────────────────────────────────────────────────────
NODE_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
WORKER_CONCURRENCY=4

# ─── Database ───────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/bloks

# ─── Redis ──────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── OpenAI (single provider for MVP — see doc 11 P0 fix #8) ───────────────
OPENAI_API_KEY=
OPENAI_PROJECT_ID=
OPENAI_ORG_ID=

# ─── Authentication (MVP single Founder account) ────────────────────────────
FOUNDER_EMAIL=
FOUNDER_PASSWORD=
SESSION_SECRET=

# ─── AI Cost & Rate Controls ────────────────────────────────────────────────
AI_MAX_RETRIES=2
AI_TASK_TIMEOUT_MS=120000
AI_MAX_COST_PER_TASK_USD=0.50
AI_DAILY_BUDGET_USD=20.00

# ─── World Simulation Tick ──────────────────────────────────────────────────
# Simulation tick interval in ms (1 real min = 1 sim workday; idle = 1:1 ratio)
WORLD_TICK_INTERVAL_MS=60000
WORLD_SNAPSHOT_INTERVAL_MS=3000

# ─── Logging ────────────────────────────────────────────────────────────────
LOG_LEVEL=debug
ENABLE_EVENT_LOG=true
ENABLE_AUDIT_LOG=true
