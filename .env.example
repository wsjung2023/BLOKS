# BLOKS OS — 환경 변수 템플릿
# git clone 후 이 파일을 복사하거나 pnpm bloks-os init 을 실행하세요.

# ── 기본 설정 ─────────────────────────────────────────────────────────────────
NODE_ENV=development
BLOKS_PROFILE=local          # local (기본) | connected (Supabase+Redis)
PORT=4000
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# ── 인증 (로컬 개발용 바이패스) ───────────────────────────────────────────────
ENABLE_DEV_BYPASS_AUTH=true
NEXT_PUBLIC_ENABLE_DEV_BYPASS_AUTH=true
NEXT_PUBLIC_DEV_BYPASS_TOKEN=dev-bypass

# ── AI (선택사항 — AI 없이도 월드/태스크/결재 기능 동작) ──────────────────────
OPENAI_API_KEY=

# ── 시뮬레이션 ────────────────────────────────────────────────────────────────
WORLD_TICK_INTERVAL_MS=60000
WORLD_SNAPSHOT_INTERVAL_MS=3000
WORKER_CONCURRENCY=4

# ── AI 비용 제한 ──────────────────────────────────────────────────────────────
AI_MAX_RETRIES=2
AI_TASK_TIMEOUT_MS=120000
AI_MAX_COST_PER_TASK_USD=0.50
AI_DAILY_BUDGET_USD=20.00

# ── 로깅 ──────────────────────────────────────────────────────────────────────
LOG_LEVEL=info
ENABLE_EVENT_LOG=true
ENABLE_AUDIT_LOG=true

# ─────────────────────────────────────────────────────────────────────────────
# 고급: Supabase 클라우드 DB (BLOKS_PROFILE=connected 일 때만 필요)
# pnpm bloks-os init 실행 시 입력하거나 아래를 직접 수정하세요.
# ─────────────────────────────────────────────────────────────────────────────
# SUPABASE_URL=https://[ref].supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
# NEXT_PUBLIC_SUPABASE_URL=https://[ref].supabase.co
# DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-1-[region].pooler.supabase.com:5432/postgres
# REDIS_URL=redis://localhost:6379
