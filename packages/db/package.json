{
  "name": "@bloks/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "generate": "prisma generate --schema prisma/schema",
    "migrate": "prisma migrate dev --schema prisma/schema",
    "push": "prisma db push --schema prisma/schema",
    "studio": "prisma studio --schema prisma/schema",
    "seed": "tsx prisma/seed.ts",
    "lint": "tsc --noEmit",
    "build": "tsc -p tsconfig.json"
  },
  "prisma": {
    "schema": "prisma/schema"
  },
  "dependencies": {
    "@prisma/client": "^6.0.0"
  },
  "devDependencies": {
    "prisma": "^6.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0"
  }
}
