{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "declarationMap": false,
    "paths": {
      "@bloks/shared": ["../../packages/shared/src/index.ts"],
      "@bloks/shared/*": ["../../packages/shared/src/*"],
      "@bloks/db": ["../../packages/db/src/index.ts"],
      "@bloks/db/*": ["../../packages/db/src/*"],
      "@bloks/agent-runtime": ["../../packages/agent-runtime/src/index.ts"],
