{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "plugins": [
      {
        "name": "next"
      }
    ],
    "jsx": "preserve",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@bloks/shared": [
        "../../packages/shared/src/index.ts"
      ],
      "@bloks/shared/*": [
        "../../packages/shared/src/*"
      ],
      "@bloks/world": [
        "../../packages/world/src/index.ts"
      ],
      "@bloks/world/*": [
        "../../packages/world/src/*"
      ],
      "@bloks/simulation": [
        "../../packages/simulation/src/index.ts"
      ],
      "@bloks/simulation/*": [
        "../../packages/simulation/src/*"
      ]
    },
    "allowJs": true,
    "noEmit": true,
    "incremental": true,
    "declarationMap": false
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
